# ORBIT Server - Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSL=false

# JWT Secrets (USE SEPARATE, LONG, RANDOM STRINGS — never share these)
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-different-from-access

# JWT Expiry (optional, defaults: 15m access / 30d refresh)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookie Settings
COOKIE_DOMAIN=
REFRESH_COOKIE_MAX_AGE_MS=2592000000

# CORS (comma-separated list of allowed frontend origins)
CLIENT_ORIGINS=http://localhost:3000

# FTP (for knowledge file uploads)
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_BASE_URL=

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Email (nodemailer)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Deadline reminders (server/utils/deadlineReminder.js)
# OFF by default: nothing is sent unless this is exactly "true".
DEADLINE_REMINDERS_ENABLED=false
# Default reminder hour (0-23, Asia/Kolkata time). Default 9.
# The job runs every hour; a member gets their reminders from this hour on,
# or from the hour they chose in Account settings -> Notifications. The same
# hour is used for the daily summary (server/utils/dailyReminder.js).
DEADLINE_REMINDER_HOUR=9
# true = only log who would be notified, send nothing. Also logs who is
# skipped because of their notification settings, and why.
DEADLINE_REMINDERS_DRY_RUN=false
# The days the office is closed: weekday names (mon tue wed thu fri sat sun),
# comma-separated. Default "sun". Example for a two-day weekend: sat,sun
# Only affects members who turned on "Skip Sundays" / "Skip weekends" in
# Account settings -> Notifications: they get nothing on these days, and the
# reminders they would have got move to the working day before (tasks coming
# due) and the working day after (tasks gone overdue).
# An empty or invalid value (an unknown name, or all seven days) falls back
# to "sun" with a warning in the log.
REMINDER_OFF_DAYS=sun

# Live updates (Server-Sent Events: server/services/eventBus.js,
# GET /api/events/stream)
# OFF by default: nothing is streamed unless this is exactly "true".
# Off: the stream endpoint answers 204, no event is published, and the
# browser refreshes its data every 30 seconds instead.
# On: needs the "location = /api/events/stream" block in docker/nginx.conf
# and a single Node process (events are kept in memory, not shared).
LIVE_EVENTS_ENABLED=false

# Auth lookup cache (server/services/authCache.js)
# Seconds the auth middleware may reuse a member's id / role / active
# status before reading it from the database again. Default 30.
# 0 = off (every request reads the database).
# Deactivating or deleting a member, a role change, a password change and
# "log out everywhere" clear the entry at once, whatever this value is.
AUTH_CACHE_TTL_SECONDS=30

# Session check (server/middleware/auth.js)
# On (default): an access token is refused as soon as its session is
# revoked (signed out from another device, password changed elsewhere,
# logged out), instead of working until the token expires.
# false = kill switch: the check is skipped completely and the middleware
# behaves exactly as it did before the check existed. The setting is logged
# once at start-up.
SESSION_CHECK_ENABLED=true

# Session check cache (server/services/sessionCache.js)
# Seconds the auth middleware may reuse "this session is active" before
# reading it from the database again. Default 30. 0 = off (every request
# reads the database). Revoking a session clears its entry at once,
# whatever this value is.
SESSION_CACHE_TTL_SECONDS=30

# Active sessions list (Account settings): a session that has not been
# used for this many days is left out of the list. It is not signed out.
# Default 7.
REFRESH_SESSION_IDLE_DAYS=7

# Reverse proxies between the browser and Node. Default 1 (the nginx inside
# the container). Set 2 when another nginx sits in front of the container
# (the VPS one) and that nginx sets X-Forwarded-For; otherwise every member
# shares one IP address, in the sessions list and in the rate limiters.
# Never set it higher than the real number of proxies: X-Forwarded-For
# could then be faked by the browser. See server/index.js.
TRUST_PROXY_HOPS=1

# Cleanup of old refresh-token rows (server/utils/refreshTokenCleanup.js)
# Runs daily at 03:30 Asia/Kolkata.
# OFF by default: nothing is deleted unless this is exactly "true".
REFRESH_TOKEN_CLEANUP_ENABLED=false
# true = only log how many rows would be deleted (also once, 30 seconds
# after start-up), delete nothing.
REFRESH_TOKEN_CLEANUP_DRY_RUN=false
# Days an expired or revoked row is kept. Default 30. Never less than the
# refresh-token lifetime (JWT_REFRESH_EXPIRES_IN) + 30 days: the larger of
# the two is used, and each run logs which one.
REFRESH_TOKEN_RETENTION_DAYS=30

# Database pool: how long an unused connection is kept open, in
# milliseconds. Default 300000 (5 minutes). The pool size stays at 5.
DB_POOL_IDLE_TIMEOUT_MS=300000

# Safety cap for full-list endpoints (my tasks, tasks of a project,
# task requests). The real total is sent in the X-Total-Count header.
# Default 1000.
LIST_SAFETY_LIMIT=1000
